#!/usr/bin/env python3
"""Добавляет выбранные папки (или текущую) в левую панель «Файлов»."""
import os
import subprocess
from pathlib import Path
from urllib.parse import unquote, urlparse

BOOKMARKS = Path.home() / '.config' / 'gtk-3.0' / 'bookmarks'


def targets():
    selected = [p for p in os.environ.get('NAUTILUS_SCRIPT_SELECTED_FILE_PATHS', '').splitlines() if p]
    if selected:
        return [Path(p) for p in selected]
    uri = os.environ.get('NAUTILUS_SCRIPT_CURRENT_URI', '')
    if uri.startswith('file://'):
        return [Path(unquote(urlparse(uri).path))]
    return []


def main():
    folders = [p for p in targets() if p.is_dir()]
    if not folders:
        subprocess.run(['notify-send', '-i', 'folder', 'Закрепить слева', 'Выбери папку'])
        return

    BOOKMARKS.parent.mkdir(parents=True, exist_ok=True)
    lines = BOOKMARKS.read_text(encoding='utf-8').splitlines() if BOOKMARKS.exists() else []
    known = {line.split(' ', 1)[0] for line in lines}

    added = []
    for folder in folders:
        uri = folder.resolve().as_uri()
        if uri not in known:
            lines.append(uri)
            known.add(uri)
            added.append(folder.name)

    if added:
        BOOKMARKS.write_text('\n'.join(lines) + '\n', encoding='utf-8')
        subprocess.run(['notify-send', '-i', 'folder', 'Закреплено слева', ', '.join(added)])
    else:
        subprocess.run(['notify-send', '-i', 'folder', 'Закрепить слева', 'Уже закреплено'])


main()

#!/usr/bin/env python3
"""Сохраняет рядом PDF-копию документов и картинок."""
import os
import subprocess
from pathlib import Path

from PIL import Image

IMAGES = {'.png', '.jpg', '.jpeg', '.webp', '.bmp', '.gif', '.tif', '.tiff'}
DOCUMENTS = {'.doc', '.docx', '.odt', '.rtf', '.txt', '.xls', '.xlsx', '.ods', '.csv', '.ppt', '.pptx', '.odp'}
LO_PROFILE = Path(os.environ.get('XDG_RUNTIME_DIR', '/tmp')) / 'nautilus-pdf-libreoffice'


def notify(title, body):
    subprocess.run(['notify-send', '-i', 'application-pdf', title, body])


def image_to_pdf(path):
    with Image.open(path) as img:
        img.convert('RGB').save(path.with_suffix('.pdf'), 'PDF', resolution=150)


def documents_to_pdf(paths):
    for path in paths:
        subprocess.run([
            'soffice', f'-env:UserInstallation={LO_PROFILE.as_uri()}',
            '--headless', '--convert-to', 'pdf', '--outdir', str(path.parent), str(path),
        ], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=180)


def main():
    files = [Path(p) for p in os.environ.get('NAUTILUS_SCRIPT_SELECTED_FILE_PATHS', '').splitlines() if p]
    images = [p for p in files if p.suffix.lower() in IMAGES]
    documents = [p for p in files if p.suffix.lower() in DOCUMENTS]
    skipped = [p.name for p in files if p not in images and p not in documents]

    if not images and not documents:
        notify('Конвертировать в PDF', 'Выбери документ или картинку')
        return

    done, failed = [], []
    for path in images:
        try:
            image_to_pdf(path)
            done.append(path.name)
        except Exception:
            failed.append(path.name)
    for path in documents:
        try:
            documents_to_pdf([path])
            done.append(path.name)
        except Exception:
            failed.append(path.name)

    lines = []
    if done:
        lines.append('Готово: ' + ', '.join(done))
    if failed:
        lines.append('Не получилось: ' + ', '.join(failed))
    if skipped:
        lines.append('Пропущено: ' + ', '.join(skipped))
    notify('PDF', '\n'.join(lines))


main()
